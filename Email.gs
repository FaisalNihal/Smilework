/**
 * Daily attendance email (trigger: every day 9-10 am).
 * Body: yesterday's attendance. Attachment: that month's attendance as Excel.
 * Recipients come from the Settings tab (email_to, email_bcc).
 */

function sendAttendanceEmail() {
  const s = getSettings_(true);
  const to = norm_(s.email_to), bcc = norm_(s.email_bcc);
  if (!to) { log_('email', 'No recipients: fill email_to in the Settings tab'); return; }
  const recipients = (to + ',' + bcc).split(',').filter(x => norm_(x)).length;
  if (MailApp.getRemainingDailyQuota() < recipients) { log_('email', 'Not enough email quota left today'); return; }

  // Make sure yesterday's numbers are final before sending.
  try { buildReports_(3); } catch (e) { log_('email.reports', e.message); }

  const yesterday = new Date(Date.now() - 864e5);
  const yKey = dayKey_(yesterday);
  const monthKey = yKey.slice(0, 7);
  const all = rows_(TAB.ATTENDANCE, ATTENDANCE_HEADERS.length);
  const dayRows = all.filter(r => cellDayKey_(r[1]) === yKey);
  const monthRows = all.filter(r => cellDayKey_(r[1]).slice(0, 7) === monthKey);
  const displayDate = fmt_(yesterday, 'dd-MMM-yyyy');
  const monthName = fmt_(yesterday, 'MMMM yyyy');

  const count = st => dayRows.filter(r => r[5] === st).length;
  const esc = v => String(v == null ? '' : v).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const badge = st => {
    const style = st === 'Present' ? 'background:#e6f4ea;color:#137333'
      : st === 'Absent' ? 'background:#fce8e6;color:#c5221f' : 'background:#f1f3f4;color:#5f6368';
    return '<span style="' + style + ';padding:3px 10px;border-radius:10px;font-weight:bold;font-size:11px">' + esc(st) + '</span>';
  };

  let html = '<div style="font-family:Arial,sans-serif;max-width:900px;margin:0 auto;border:1px solid #e0e0e0;border-radius:8px;overflow:hidden">' +
    '<div style="padding:20px 24px;border-bottom:4px solid #E3000F">' +
    '<div style="font-size:20px;font-weight:bold;color:#222">Daily Attendance Report</div>' +
    '<div style="font-size:14px;color:#666;margin-top:4px">Smile Corner merchandisers &bull; <b style="color:#E3000F">' + displayDate + '</b></div></div>' +
    '<div style="padding:16px 24px;font-size:14px;color:#333">Present: <b>' + count('Present') + '</b> &nbsp; Absent: <b>' +
    count('Absent') + '</b> &nbsp; Weekend/Holiday: <b>' + (count('Weekend') + count('Holiday')) + '</b>' +
    '<br>The full month is attached as an Excel file.</div>' +
    '<table style="width:100%;border-collapse:collapse;font-size:13px"><tr style="background:#E3000F;color:#fff;text-align:left">' +
    '<th style="padding:10px 8px">Region</th><th style="padding:10px 8px">Distributor</th><th style="padding:10px 8px">Merchandiser</th>' +
    '<th style="padding:10px 8px;text-align:center">Status</th><th style="padding:10px 8px;text-align:center">Planned</th>' +
    '<th style="padding:10px 8px;text-align:center">Visited</th><th style="padding:10px 8px;text-align:center">Hours</th></tr>';
  dayRows.forEach((r, i) => {
    html += '<tr style="background:' + (i % 2 ? '#fafafa' : '#fff') + ';border-bottom:1px solid #eee">' +
      '<td style="padding:8px">' + esc(r[2]) + '</td><td style="padding:8px">' + esc(r[3]) + '</td>' +
      '<td style="padding:8px;color:#222">' + esc(r[4]) + '</td><td style="padding:8px;text-align:center">' + badge(r[5]) + '</td>' +
      '<td style="padding:8px;text-align:center">' + esc(r[6]) + '</td><td style="padding:8px;text-align:center;font-weight:bold">' +
      esc(r[7]) + '</td><td style="padding:8px;text-align:center">' + esc(Number(r[8] || 0).toFixed(2)) + '</td></tr>';
  });
  if (!dayRows.length) html += '<tr><td colspan="7" style="padding:30px;text-align:center;color:#888">No attendance data for ' + displayDate + '</td></tr>';
  html += '</table><div style="padding:14px;text-align:center;background:#f8f9fa;color:#888;font-size:12px">' +
    'Auto-generated by the Smile Corner app. Please do not reply.</div></div>';

  const attachment = monthExcel_(monthRows, 'Attendance_' + monthName.replace(' ', '_'));
  MailApp.sendEmail({
    to: to, bcc: bcc, subject: 'Merchandiser Daily Attendance – ' + displayDate, htmlBody: html,
    attachments: attachment ? [attachment] : []
  });
}

/** Builds a temporary spreadsheet with the month's rows, exports it as .xlsx, then deletes it. */
function monthExcel_(rows, name) {
  let tmp = null;
  try {
    tmp = SpreadsheetApp.create(name);
    const sh = tmp.getSheets()[0];
    sh.getRange(1, 1, 1, ATTENDANCE_HEADERS.length).setValues([ATTENDANCE_HEADERS]).setFontWeight('bold');
    if (rows.length) {
      sh.getRange(2, 1, rows.length, ATTENDANCE_HEADERS.length).setValues(rows);
      sh.getRange(2, 1, rows.length, 1).setNumberFormat('mmmm yyyy');
      sh.getRange(2, 2, rows.length, 1).setNumberFormat('yyyy-mm-dd');
    }
    SpreadsheetApp.flush();
    const resp = UrlFetchApp.fetch('https://docs.google.com/spreadsheets/d/' + tmp.getId() + '/export?format=xlsx', {
      headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() }, muteHttpExceptions: true
    });
    if (resp.getResponseCode() !== 200) { log_('email.excel', 'Export failed: HTTP ' + resp.getResponseCode()); return null; }
    return resp.getBlob().setName(name + '.xlsx');
  } catch (e) {
    log_('email.excel', e.message);
    return null;
  } finally {
    if (tmp) { try { DriveApp.getFileById(tmp.getId()).setTrashed(true); } catch (e) { /* ignore */ } }
  }
}

/** Menu helper: send the email now, to check it. */
function sendTestEmail() {
  sendAttendanceEmail();
}
